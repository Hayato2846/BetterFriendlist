									<Anchor point="TOPLEFT" relativeKey="$parent.ScrollableWarningText" relativePoint="TOPRIGHT" x="17" />
									<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollableWarningText" relativePoint="BOTTOMRIGHT" x="17" />
								</Anchors>
							</EventFrame>
						</Frames>
						<Scripts><OnMouseWheel function="nop" /></Scripts>
					</Frame>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
						<Anchors><Anchor point="TOPLEFT" /><Anchor point="BOTTOMRIGHT" x="-18" /></Anchors>
					</Frame>
					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
						<Anchors><Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="4" /><Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="4" /></Anchors>
					</EventFrame>
				</Frames>
				<Layers><Layer level="ARTWORK"><FontString parentKey="EmptyLabel" inherits="BetterFriendlistFontLarge" justifyH="CENTER" wordwrap="true" hidden="true"><Anchors><Anchor point="CENTER" /><Anchor point="LEFT" x="30" /><Anchor point="RIGHT" x="-30" /></Anchors><Color color="FRIENDS_GRAY_COLOR" /></FontString></Layer></Layers>
			</Frame>
		</Frames>
	</Frame>
</Ui>
