<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- Native Blizzard shell; theme integrations replace this surface after it exists. -->
	<Frame name="BFLAppearanceOnboardingFrame" parent="UIParent" inherits="ButtonFrameTemplate" hidden="true" enableMouse="true" toplevel="true" frameStrata="DIALOG" clampedToScreen="true">
		<Size x="560" y="590" />
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="StepText" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="MIDDLE" maxLines="1" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="62" y="-35" />
						<Anchor point="TOPRIGHT" x="-30" y="-35" />
					</Anchors>
				</FontString>
				<FontString parentKey="Subtitle" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP" maxLines="3" wordwrap="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Inset" relativePoint="TOPLEFT" x="17" y="-15" />
						<Anchor point="TOPRIGHT" relativeKey="$parent.Inset" relativePoint="TOPRIGHT" x="-17" y="-15" />
					</Anchors>
				</FontString>
				<Texture parentKey="HeaderDivider" file="Interface\Buttons\WHITE8X8">
					<Size y="1" />
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Inset" relativePoint="TOPLEFT" x="17" y="-73" />
						<Anchor point="TOPRIGHT" relativeKey="$parent.Inset" relativePoint="TOPRIGHT" x="-17" y="-73" />
					</Anchors>
					<Color r="0.5" g="0.5" b="0.5" a="0.35" />
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Content">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Inset" relativePoint="TOPLEFT" x="17" y="-87" />
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Inset" relativePoint="BOTTOMRIGHT" x="-17" y="16" />
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				local module = BFL and BFL:GetModule("AppearanceOnboarding");
				if module and module.OnFrameLoad then module:OnFrameLoad(self); end
			</OnLoad>
			<OnHide>
				local module = BFL and BFL:GetModule("AppearanceOnboarding");
				if module and module.OnFrameHide then module:OnFrameHide(self); end
			</OnHide>
		</Scripts>
	</Frame>
</Ui>
